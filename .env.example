# ─── Banco de dados ───────────────────────────────────────────────
DATABASE_URL=mysql://root:senha123@localhost:3306/autonf

# ─── Redis (fila de processamento) ───────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Criptografia (AES-256-GCM) ──────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=cole_aqui_uma_chave_de_64_caracteres_hexadecimais

# ─── Clerk (autenticação) ─────────────────────────────────────────
# Crie em: https://dashboard.clerk.com → New Application → copie as chaves em API Keys
CLERK_SECRET_KEY=sk_test_sua_chave_secreta_aqui
VITE_CLERK_PUBLISHABLE_KEY=pk_test_sua_chave_publicavel_aqui

# ─── Asaas (gateway de pagamento) ─────────────────────────────────
ASAAS_API_KEY=sua_chave_do_asaas_aqui
ASAAS_ENV=sandbox

# ─── Email ────────────────────────────────────────────────────────
RESEND_API_KEY=re_sua_chave_do_resend
EMAIL_FROM=noreply@seudominio.com.br

# ─── Cloudflare R2 (armazenamento de PDFs em produção) ───────────
# Crie em: Cloudflare Dashboard → R2 → Create Bucket → Manage → API Tokens
# Em desenvolvimento local, deixe em branco — usa ./storage/pdfs no disco
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=autonf-pdfs

# ─── PDFs (fallback local — só usado se R2 não estiver configurado) ──
PDF_STORAGE_PATH=./storage/pdfs

# ─── Servidor ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── NFS-e (ambiente da prefeitura) ──────────────────────────────
# Use "homologacao" para testes e "producao" para ir ao ar de verdade
NFSE_ENV=homologacao

# ─── Dono do sistema (openId do usuário admin) ────────────────────
OWNER_OPEN_ID=

# ─── URL pública ──────────────────────────────────────────────────
PUBLIC_URL=http://localhost:3000
