{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "jsx": "preserve",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["server/**/*", "drizzle/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "client"]
}
